APP_ENV=testing
APP_DEBUG=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ai_companion_testing
DB_USERNAME=ai_companion
DB_PASSWORD=change_me

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=4

# Chatbot
CHAT_RECENT_MESSAGE_LIMIT=20
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_RESPONSE_MAX_LENGTH=12000
CHAT_GENERATION_RATE_LIMIT=20
CHAT_RESET_RATE_LIMIT=3
CHAT_RESET_CONFIRMATION=BORRAR
CHAT_STREAMING=true

# Semantic memory
MEMORY_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_MINIMUM_SIMILARITY=0.64
MEMORY_MINIMUM_IMPORTANCE=0.40

# Automatic memory extraction
MEMORY_EXTRACTION_ENABLED=false
MEMORY_EXTRACTION_QUEUE=memory
MEMORY_EXTRACTION_MESSAGE_LIMIT=8
MEMORY_EXTRACTION_MAX_MEMORIES=4
MEMORY_EXTRACTION_MINIMUM_IMPORTANCE=0.45
MEMORY_EXTRACTION_MINIMUM_CONFIDENCE=0.70
MEMORY_EXTRACTION_DUPLICATE_SIMILARITY=0.92
MEMORY_EXTRACTION_PROVIDER=ollama
MEMORY_EXTRACTION_MODEL=qwen3:4b-instruct
MEMORY_EXTRACTION_TIMEOUT=120

# AI providers
AI_CHAT_DRIVER=simulated
AI_CHAT_PROVIDER=openai
AI_CHAT_MODEL=gpt-5.4-mini
AI_CHAT_TIMEOUT=30
AI_EMBEDDING_DRIVER=simulated
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_TIMEOUT=30

OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=false

# Local AI - Ollama
OLLAMA_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

DB_QUEUE_RETRY_AFTER=300
CONVERSATION_SUMMARY_ENABLED=false
CONVERSATION_SUMMARY_QUEUE=summary
CONVERSATION_SUMMARY_MESSAGE_THRESHOLD=12
CONVERSATION_SUMMARY_RECENT_MESSAGE_LIMIT=8
CONVERSATION_SUMMARY_MAX_MESSAGES=40
CONVERSATION_SUMMARY_MAX_CHARACTERS=2500
CONVERSATION_SUMMARY_PROVIDER=ollama
CONVERSATION_SUMMARY_MODEL=qwen3:4b-instruct
CONVERSATION_SUMMARY_TIMEOUT=120
RELATIONSHIP_ANALYSIS_ENABLED=false
RELATIONSHIP_ANALYSIS_QUEUE=relationship
RELATIONSHIP_ANALYSIS_PROVIDER=ollama
RELATIONSHIP_ANALYSIS_MODEL=qwen3:4b-instruct
RELATIONSHIP_ANALYSIS_TIMEOUT=120
