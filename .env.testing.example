APP_ENV=testing
APP_DEBUG=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ai_companion_testing
DB_USERNAME=ai_companion
DB_PASSWORD=change_me

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=4

# Chatbot
CHAT_RECENT_MESSAGE_LIMIT=20
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_RESET_CONFIRMATION=BORRAR
CHAT_STREAMING=true

# Semantic memory
MEMORY_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_MINIMUM_SIMILARITY=0.65
MEMORY_MINIMUM_IMPORTANCE=0.40

# AI providers
AI_CHAT_DRIVER=simulated
AI_CHAT_PROVIDER=openai
AI_CHAT_MODEL=gpt-5.4-mini
AI_CHAT_TIMEOUT=30
AI_EMBEDDING_DRIVER=simulated

OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=false
